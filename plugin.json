{
    "$schema": "https://github.com/AvengeMedia/DankMaterialShell/raw/refs/heads/master/PLUGINS/plugin-schema.json",
    "id": "screenshotPlus",
    "name": "Screenshot+",
    "description": "Region screenshot with live annotation — draw while you select. Rect, ellipse, line, arrow, pen, highlighter, text, mosaic, numbered markers; configurable toolbar.",
    "version": "0.2.0",
    "author": "id",
    "icon": "screenshot_region",
    "type": "composite",
    "capabilities": [
        "daemon"
    ],
    "components": {
        "daemon": "./ScreenshotPlusDaemon.qml"
    },
    "settings": "./ScreenshotPlusSettings.qml",
    "requires_dms": ">=1.6.0",
    "requires": [],
    "permissions": [
        "settings_read",
        "settings_write",
        "shell_execute"
    ]
}
